  label: "\uBCF4\uB9AC \xB7 \uCCAB \uC815\uCC29\uACFC \uC624\uB298\uC758 \uC7A5\uBCF4\uAE30"
  topics:
  - topic: 0
    thinkingLines:
    - "\uBCF4\uB9AC\uC608\uC694. \uC624\uB298 \uBC24\uC5D4 \uC5EC\uAE30\uC11C \uBB3C\uAC74\uC744
      \uACE0\uB97C \uC218 \uC788\uC744\uAE4C\uC694? \uB0AE\uC5D0 \uBAA8\uC740 \uC7AC\uB8CC\uB3C4
      \uC88B\uC544\uC694. \uC624\uB298 \uC4F8 \uAC83\uBD80\uD130 \uCC3E\uC544\uBCFC\uAC8C\uC694."
    feelingLines:
    - "\uBCF4\uB9AC\uC608\uC694. \uC624\uB298 \uBC24\uC5D4 \uC5EC\uAE30\uC11C \uBB3C\uAC74\uC744
      \uACE0\uB97C \uC218 \uC788\uC744\uAE4C\uC694? \uB0AE\uC5D0 \uBAA8\uC740 \uC7AC\uB8CC\uB3C4
      \uC88B\uC544\uC694. \uC624\uB298 \uC4F8 \uAC83\uBD80\uD130 \uCC3E\uC544\uBCFC\uAC8C\uC694."
  - topic: 1
    thinkingLines:
    - "\uC544\uC9C1 \uAE38\uC774 \uB0AF\uC124\uC5B4\uC694. \uADF8\uB798\uB3C4 \uAC00\uAC8C\uAC00
      \uBCF4\uC774\uBA74 \uC9D1\uC5D0 \uAC00\uAE4C\uC6CC\uC9C4 \uAC83 \uAC19\uC544\uC694."
    feelingLines:
    - "\uC544\uC9C1 \uAE38\uC774 \uB0AF\uC124\uC5B4\uC694. \uADF8\uB798\uB3C4 \uAC00\uAC8C\uAC00
      \uBCF4\uC774\uBA74 \uC9D1\uC5D0 \uAC00\uAE4C\uC6CC\uC9C4 \uAC83 \uAC19\uC544\uC694."
  - topic: 2
    thinkingLines:
    - "\uC624\uB298 \uD544\uC694\uD55C \uAC83\uBD80\uD130 \uBCFC\uAC8C\uC694. \uAC00\uACA9\uB3C4
      \uC0B4\uD3B4\uBCF4\uACE0\uC694."
