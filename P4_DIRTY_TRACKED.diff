     private string DisplayName =>
         profile != null && !string.IsNullOrEmpty(profile.npcName) ? profile.npcName : gameObject.name;
 
+    // P4 first-settlement exception uses this producer's timer and actual stock.
+    bool _starterSession, _starterClaimed, _starterReady;
+    public bool StarterBatchReady => _starterSession && _starterReady && !_starterClaimed;
+    public bool StarterClaimed => _starterClaimed;
+    public int StarterStockCount => _starterSession ? TotalInventoryCount() : 0;
+    public bool StarterWorking => _starterSession && !_starterReady && !_starterClaimed && !_schedulePaused;
+
+    public void ConfigureStarterSession()
+    {
+        _starterSession = true; _starterClaimed = false; _starterReady = false;
+        _npcInventory.Clear(); _productionTimer = 0; _pendingProductionAmount = 0;
+        _restoredFromSave = true; _schedulePaused = true; ChangeState(State.Idle);
+    }
+
+    public void StartStarterWork()
+    {
+        if (!_starterSession || _starterClaimed || _starterReady || StarterWorking) return;
+        _schedulePaused = false;
+        BeginWork();
+    }
+
+    public bool TryClaimStarterBatch(Inventory inventory)
+    {
+        if (!StarterBatchReady || inventory == null || _npcInventory.Count != 1) return false;
+        var stock = _npcInventory[0];
+        if (!inventory.CanAddItems(stock.data, stock.count) || !inventory.AddInstance(stock)) return false;
+        _npcInventory.Clear(); _starterClaimed = true; _starterReady = false;
+        _schedulePaused = true; ChangeState(State.Idle);
+        Debug.Log("[VS-P4] STARTER_CLAIM_ONCE " + productionData.producedItem.itemName);
+        return true;
+    }
+
+    public StarterProducerSaveData CaptureStarterState() => new StarterProducerSaveData {
+        active = StarterWorking, ready = _starterReady, claimed = _starterClaimed,
+        elapsed = _productionTimer, pendingAmount = _pendingProductionAmount, stockCount = TotalInventoryCount()
+    };
+
+    public void RestoreStarterState(StarterProducerSaveData state)
+    {
+        ConfigureStarterSession();
+        if (state == null) return;
+        _starterClaimed = state.claimed; _starterReady = state.ready;
+        if (state.stockCount > 0) _npcInventory.Add(new ItemInstance(productionData.producedItem, state.stockCount));
+        if (state.active) { _schedulePaused = false; BeginWork(); }
+        _productionTimer = Mathf.Max(0, state.elapsed);
+        _pendingProductionAmount = state.pendingAmount > 0 ? state.pendingAmount : CalculateProductionAmount();
+    }
+
